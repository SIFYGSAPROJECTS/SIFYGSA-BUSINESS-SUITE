# Secreto criptográfico de al menos 32 caracteres para firmar los JWT (librería jose)
AUTH_SECRET="sifygsa_erp_super_secret_jwt_key_2026_production_grade_min32chars"

# Tiempo de expiración de sesión en segundos (por defecto 28800 = 8 horas)
SESSION_DURATION_SECONDS="28800"

# Tiempo máximo de inactividad en minutos antes de cerrar sesión automáticamente (por defecto 30)
SESSION_INACTIVITY_MINUTES="30"

# Entorno de ejecución (development | production | test)
NODE_ENV="development"
