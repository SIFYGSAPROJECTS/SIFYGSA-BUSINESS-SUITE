# Secreto criptográfico de al menos 32 caracteres para firmar los JWT (librería jose)
AUTH_SECRET="sifygsa_erp_super_secret_jwt_key_2026_production_grade_min32chars"

# Tiempo de expiración de sesión en segundos (por defecto 28800 = 8 horas)
SESSION_DURATION_SECONDS="28800"

# Tiempo máximo de inactividad en minutos antes de cerrar sesión automáticamente (por defecto 30)
SESSION_INACTIVITY_MINUTES="30"

# Entorno de ejecución (development | production | test)
NODE_ENV="development"

# Backend NestJS (puerto y proxy desde Next.js)
BACKEND_PORT="4000"
BACKEND_API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB (Bitácoras e Imágenes)
# Opción A — MongoDB Atlas (nube compartida):
MONGODB_URI="mongodb+srv://<usuario>:<password>@clustersify.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Opción B — MongoDB local con Docker (`npm run docker:mongo`):
# MONGODB_URI="mongodb://localhost:27017/BitacoraSifigsa"

# Opcional — Si corres `docker compose up` pero quieres que el contenedor use Atlas en vez del Mongo local:
# DOCKER_MONGODB_URI="mongodb+srv://<usuario>:<password>@clustersify.xxxxx.mongodb.net/?retryWrites=true&w=majority"

MONGODB_BITACORAS_DB="BitacoraSifigsa"
MONGODB_IMAGENES_DB="ImagenesSifigsa"

# PostgreSQL (Opcional por ahora - listo para activar en backend/src/database/postgres.service.ts)
# DATABASE_URL="postgresql://<usuario>:<password>@localhost:5432/sifygsa_erp"
