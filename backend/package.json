{
  "name": "sifygsa-backend-nestjs",
  "version": "4.0.0",
  "description": "Backend empresarial escalable en NestJS para SIFYGSA Business Suite (Auth, Admin, CRM, Requisiciones, Compras, Almacén, RRHH, MongoDB Atlas & PostgreSQL)",
